{
  "name": "@anvara/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prisma": "prisma",
    "seed": "tsx --env-file=../../.env prisma/seed.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@anvara/prettier-config",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.26",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@anvara/config": "workspace:*",
    "@anvara/eslint-config": "workspace:*",
    "@anvara/prettier-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.21.0",
    "eslint": "^9.39.5",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
